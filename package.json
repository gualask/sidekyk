{
    "name": "sidekyk",
    "private": true,
    "version": "0.1.0",
    "description": "Lightweight desktop companion for reviewing what changed in a local git working tree, built with Tauri 2.",
    "author": "gualask",
    "license": "MIT",
    "repository": "github:gualask/sidekyk",
    "packageManager": "pnpm@11.22.0",
    "type": "module",
    "scripts": {
        "format": "biome format --write .",
        "boundaries:check": "node scripts/check-boundaries.mjs",
        "knip": "knip",
        "lint": "biome check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build"
    },
    "dependencies": {
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@tabler/icons-react": "^3.46.0",
        "@tanstack/react-query": "^5.102.5",
        "@tauri-apps/api": "^2.11.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.10",
        "@rolldown/plugin-transform-imports": "^0.1.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "knip": "^6.32.3",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
