{
    "name": "sidekyk",
    "private": true,
    "version": "0.1.0",
    "description": "Lightweight desktop companion for reviewing what changed in a local git working tree, built with Tauri 2.",
    "author": "gualask",
    "license": "MIT",
    "repository": "github:gualask/sidekyk",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": "^26"
    },
    "type": "module",
    "scripts": {
        "format": "biome format --write .",
        "boundaries:check": "node scripts/check-boundaries.mjs",
        "i18n:check": "node scripts/check-i18n.mjs",
        "knip": "knip",
        "lint": "biome check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@tabler/icons-react": "^3.51.0",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-virtual": "3.14.26",
        "@tauri-apps/api": "^2.12.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.7",
        "@rolldown/plugin-transform-imports": "^0.1.3",
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/cli": "^2.12.4",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "happy-dom": "^21.0.4",
        "knip": "^6.45.1",
        "tailwindcss": "^4.3.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
