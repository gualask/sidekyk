{
    "name": "sidekyk",
    "private": true,
    "version": "0.1.0",
    "description": "Lightweight desktop companion for reviewing what changed in a local git working tree, built with Tauri 2.",
    "author": "gualask",
    "license": "MIT",
    "repository": "github:gualask/sidekyk",
    "packageManager": "pnpm@11.22.0",
    "type": "module",
    "scripts": {
        "format": "biome format --write .",
        "boundaries:check": "node scripts/check-boundaries.mjs",
        "knip": "knip",
        "lint": "biome check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "tauri": "tauri",
        "tauri:dev": "tauri dev",
        "tauri:build": "tauri build"
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@tabler/icons-react": "^3.49.0",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-virtual": "3.14.14",
        "@tauri-apps/api": "^2.12.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@rolldown/plugin-transform-imports": "^0.1.2",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.1",
        "@types/node": "^24.12.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "knip": "^6.41.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
